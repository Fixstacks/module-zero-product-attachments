 *
 * The product's files: title, kind and size, each opening in a new tab.
 * Nothing (and so no section) for a product without files.
 *
 * @var \Magento\Catalog\Block\Product\View $block
 * @var \Magento\Framework\Escaper $escaper
 */
/** @var \Zero\ProductAttachments\ViewModel\Downloads $downloads */
$downloads = $block->getData('downloads');
$files = $downloads->files($block->getProduct());
if (!$files) {
    return;
}
$icons = [
    'pdf' => '<path d="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8z"/><path d="M14 3v5h5"/><path d="M9 15h6M9 18h4"/>',
    'image' => '<rect x="3" y="4" width="18" height="16" rx="2"/><circle cx="9" cy="10" r="2"/><path d="m21 17-5-5-9 8"/>',
    'archive' => '<path d="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8z"/><path d="M14 3v5h5"/><path d="M11 6h1M11 9h1M11 12h1M10.5 15h2v3h-2z"/>',
    'document' => '<path d="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8z"/><path d="M14 3v5h5"/><path d="M9 12h6M9 15h6M9 18h4"/>',
];
?>
<ul class="zero-downloads" data-zero-downloads>
    <?php foreach ($files as $file): ?>
        <li>
            <a href="<?= $escaper->escapeUrl($file['url']) ?>" target="_blank" rel="noopener">
                <svg aria-hidden="true" viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><?= /* @noEscape */ $icons[$file['kind']] ?? $icons['document'] ?></svg>
                <span class="zero-downloads-title"><?= $escaper->escapeHtml($file['title']) ?></span>
                <span class="zero-downloads-meta"><?= $escaper->escapeHtml($file['type'] . ' · ' . $file['size']) ?></span>
            </a>
        </li>
    <?php endforeach; ?>
</ul>

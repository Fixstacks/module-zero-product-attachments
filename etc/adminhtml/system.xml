<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Config:etc/system_file.xsd">
    <system>
        <section id="zero_attachments" translate="label" type="text" sortOrder="48" showInDefault="1" showInWebsite="1" showInStore="1">
            <label>Product Attachments</label>
            <tab>zero</tab>
            <resource>Zero_ProductAttachments::config</resource>
            <group id="general" translate="label comment" type="text" sortOrder="10" showInDefault="1" showInWebsite="1" showInStore="1">
                <label>Product Attachments</label>
                <comment>Manuals, data sheets, certificates and the like on product pages (Catalog > Product Attachments).</comment>
                <field id="enabled" translate="label" type="select" sortOrder="10" showInDefault="1" showInWebsite="1" showInStore="1" canRestore="1">
                    <label>Enabled</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                </field>
                <field id="title" translate="label comment" type="text" sortOrder="20" showInDefault="1" showInWebsite="1" showInStore="1" canRestore="1">
                    <label>Section Title</label>
                    <comment>The heading of the files' section on the product page.</comment>
                </field>
                <field id="max_size" translate="label comment" type="text" sortOrder="30" showInDefault="1" canRestore="1">
                    <label>Largest File (MB)</label>
                    <comment>Also limited by PHP's upload_max_filesize and post_max_size.</comment>
                    <validate>validate-digits validate-greater-than-zero</validate>
                </field>
            </group>
        </section>
    </system>
</config>
